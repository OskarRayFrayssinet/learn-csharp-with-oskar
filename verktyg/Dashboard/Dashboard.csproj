<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Elevens lokala dashboard. Ligger medvetet INTE i learn-csharp-with-oskar.sln,
    eftersom verktyget själv bygger och testar solutionen.
    Starta med dashboard.cmd i repots rotmapp, eller:
      dotnet run (med verktyg/Dashboard som projekt)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
